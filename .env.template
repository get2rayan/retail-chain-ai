INFERENCE_BASE_URL="inference-api-base-url-here eg: https://openrouter.ai/api/v1/"
INFERENCE_API_KEY="your-inference-api-key-here"
INFERENCE_MODEL="inference-model-name-here eg: openai/gpt-6-luna"

IMAGE_BASE_URL="image-api-base-url-here eg: https://api.openai.com/v1/"
IMAGE_API_KEY="your-image-api-key-here"
IMAGE_MODEL="image-model-here eg: google/gemini-2.5-flash-image"

# MCP Server Url (direct access)
MCP_SERVER_URL="your-mcp-server-url eg: http://localhost:8000/mcp"

# MCP Server Url (behind AI gateway access)
MCP_SERVER_AIGW_URL="your-mcp-gateway-url-here"
MCP_SERVER_AIGW_API_KEY="your-mcp-gateway-api-key-here"
MCP_SERVER_AIGW_AUTH_HEADER="Authorization"
MCP_SERVER_AIGW_AUTH_SCHEME="Bearer"

STORE_PRODUCTS_FILE="store_products.csv"

# Guardrail settings
GUARDRAIL_ENABLE_PRESIDIO=true
GUARDRAIL_ENABLE_DEBERTA=true
GUARDRAIL_ENABLE_DETOXIFY=true
GUARDRAIL_INJECTION_THRESHOLD=0.5
GUARDRAIL_TOXICITY_THRESHOLD=0.5